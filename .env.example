# Your free-tier key from Google AI Studio
GEMINI_API_KEY=your-key-here

# The model ID used for YES/NO decisions
GEMINI_MODEL=gemini-3.1-flash-lite

# Dev-only testing switch: none | invalid-once | invalid-always
LLM_FAULT_INJECTION=none

# Dev-only demo switch: extra milliseconds to wait inside each node (0 to 10000), so you can watch a run
DEMO_STEP_DELAY_MS=0
